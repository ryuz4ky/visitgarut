# Analytics (off until set; read at request time, no rebuild needed). Either or both.
PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SRC=https://plausible.io/js/script.js
GA_MEASUREMENT_ID=
# Official profiles for Organization.sameAs, comma separated
VISITGARUT_SAME_AS=
# Editorial team on /tentang#tim: "Nama|Peran|https://profil;Nama|Peran"
VISITGARUT_EDITORS=
