NEXT_PUBLIC_SITE_URL=https://visitgarut.com
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ADMIN_SETUP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
PORT=3187
HOSTNAME=127.0.0.1

# Optional official YouTube connector. Never commit real keys.
YOUTUBE_API_KEY=
# Set only after YouTube grants derived-metrics permission for this API client.
